# Core Application Settings
PORT=3000
NODE_ENV=development
APP_URL=https://ais-dev-b3apq72jt36am5weartmci-112454926431.asia-northeast1.run.app

# MongoDB Atlas Persistent Cluster URI (REQUIRED)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aurelia_commerce?retryWrites=true&w=majority

# Administrative Root Credentials
ADMIN_EMAIL=admin@novaracommerce.com
ADMIN_PASSWORD=admin123456

# Session & JWT Signing
JWT_SECRET=novara_commerce_default_super_secret_jwt_key_2026

# Google OAuth 2.0 Credentials (Google Cloud Console > APIs & Services > Credentials)
# Authorized Redirect URI: https://<domain>/auth/callback/google
# Authorized JavaScript Origins: https://<domain>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta / Facebook OAuth App Credentials (developers.facebook.com > My Apps > Facebook Login)
# Valid OAuth Redirect URI: https://<domain>/auth/callback/facebook
