FACEBOOK_APP_SECRET=

# Cloudinary Media Assets Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend Transactional Email (Optional)
RESEND_API_KEY=
EMAIL_FROM=orders@novaracommerce.com